{
  "name": "advent-of-code",
  "version": "1.0.0",
  "description": "Advent of Code solutions across multiple years",
  "type": "module",
  "private": true,
  "scripts": {
    "solve": "node scripts/runner.js",
    "start-day": "node scripts/start-day.js",
    "fetch-input": "node scripts/fetch-input.js",
    "get-problem": "node scripts/get-problem.js",
    "submit": "node scripts/submit.js",
    "list-days": "node scripts/list-days.js",
    "check-day": "node scripts/check-day.js",
    "help": "node scripts/help.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build",
    "dev": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
