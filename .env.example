# Advent of Code Session Token
# Get this from your browser cookies after logging in to adventofcode.com
AOC_SESSION=your_session_token_here

# Sent as part of the User-Agent when fetching/submitting puzzles, so AoC's
# maintainer can identify and reach out about a misbehaving script.
AOC_GITHUB_USERNAME=your_github_username
AOC_CONTACT_EMAIL=your_email@example.com
